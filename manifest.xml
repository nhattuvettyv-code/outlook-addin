<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">

  <!-- Identity -->
  <Id>2c7b8d3a-4f1e-4a9c-b862-1d3e5f7a9c0b</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Your Organisation</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Customer Name Validator"/>
  <Description DefaultValue="Blocks emails whose subject [Customer Name] does not match recipient domains."/>

  <!-- Icons -->
  <IconUrl DefaultValue="https://nhattuvettyv-code.github.io/outlook-addin/assets/icon-80.png"/>
  <HighResolutionIconUrl DefaultValue="https://nhattuvettyv-code.github.io/outlook-addin/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://github.com/nhattuvettyv-code/outlook-addin"/>

  <!-- Host requirements -->
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <!-- Form settings -->
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://nhattuvettyv-code.github.io/outlook-addin/src/commands.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- Permissions -->
  <Permissions>ReadWriteItem</Permissions>

  <!-- Rule -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

  <!-- Version Overrides — Smart Alert wired here -->
  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <VersionOverrides
      xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
      xsi:type="VersionOverridesV1_1"
      SendMode="PromptUser">

      <Requirements>
        <bt:Sets>
          <bt:Set Name="Mailbox" MinVersion="1.12"/>
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>

            <FunctionFile resid="Commands.Url"/>

            <ExtensionPoint xsi:type="Events">
              <Event
                Type="OnMessageSend"
                FunctionExecution="synchronous"
                FunctionName="onMessageSendHandler"/>
            </ExtensionPoint>

          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://nhattuvettyv-code.github.io/outlook-addin/src/commands.html"/>
        </bt:Urls>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://nhattuvettyv-code.github.io/outlook-addin/assets/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://nhattuvettyv-code.github.io/outlook-addin/assets/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://nhattuvettyv-code.github.io/outlook-addin/assets/icon-80.png"/>
        </bt:Images>
        <bt:ShortStrings>
          <bt:String id="AddInName" DefaultValue="Customer Name Validator"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="AddInDescription"
            DefaultValue="Blocks emails whose subject [Customer Name] does not match recipient domains."/>
        </bt:LongStrings>
      </Resources>

    </VersionOverrides>
  </VersionOverrides>

</OfficeApp>
